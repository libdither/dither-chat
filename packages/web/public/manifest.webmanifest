{
  "id": "/",
  "name": "dither-chat",
  "short_name": "dither",
  "description": "Discord, Signal and Matrix in one hub",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "categories": ["social", "productivity"],
  "background_color": "#14151b",
  "theme_color": "#14151b",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Inbox", "url": "/#/inbox", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "People", "url": "/#/people", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "All communities", "url": "/#/directory", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search", "url": "/#/search", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
