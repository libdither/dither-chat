<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="dither-chat test push">
        <!-- The distributor's side of UnifiedPush, and the test's two commands (Distributor.kt). Exported: the app's
             connector and adb's shell both send to it. Test-only, never shipped. -->
        <receiver
            android:name=".Distributor"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.distributor.REGISTER" />
                <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
                <action android:name="org.unifiedpush.android.distributor.MESSAGE_ACK" />
                <action android:name="org.libdither.chat.testpush.SERVER" />
                <action android:name="org.libdither.chat.testpush.DELIVER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
