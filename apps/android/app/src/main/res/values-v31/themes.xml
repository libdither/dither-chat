<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dither" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- The system splash: same colour as the page behind it, so it hands over without a flash. -->
        <item name="android:windowSplashScreenBackground">@color/app_bg</item>
        <!-- The page's loading sphere dithering in (drawable/splash_orb.xml); MainActivity holds it until the page shows. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_orb</item>
        <item name="android:windowSplashScreenAnimationDuration">600</item>
    </style>
</resources>
