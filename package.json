{
  "name": "dither-chat",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "hub": "bun packages/hub/src/main.ts",
    "web:dev": "cd packages/web && bunx --bun vite",
    "web:build": "cd packages/web && bunx --bun vite build",
    "typecheck": "bun scripts/typecheck.ts",
    "test": "bun scripts/test-all.ts",
    "budgets": "bun scripts/budgets.ts",
    "check:boot": "bun scripts/check-boot.ts",
    "check:tests": "bun scripts/check-tests.ts",
    "accounts:check": "bun scripts/accounts-sync.ts --check",
    "check:cycles": "bun scripts/check-cycles.ts",
    "knip": "knip --include files,dependencies,unlisted,unresolved,binaries --no-progress --treat-config-hints-as-errors"
  },
  "devDependencies": {
    "@dither-chat/protocol": "workspace:*",
    "@types/bun": "latest",
    "acorn": "^8.19.0",
    "knip": "^5.88.1",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@napi-rs/canvas": "file:./packages/web/stubs/no-canvas"
  }
}
