{
  "name": "dither-chat",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "hub": "bun packages/hub/src/main.ts",
    "web:dev": "cd packages/web && bunx --bun vite",
    "web:build": "cd packages/web && bunx --bun vite build",
    "typecheck": "bun scripts/typecheck.ts",
    "test": "bun scripts/test-all.ts",
    "accounts:check": "bun scripts/accounts-sync.ts --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "acorn": "^8.19.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@napi-rs/canvas": "file:./packages/web/stubs/no-canvas"
  }
}
